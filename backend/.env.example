# =====================================================================
# Render.com / Production Environment Variables Template
# Copy these values into your Render Dashboard under:
# Your Web Service -> Environment -> Environment Variables
# =====================================================================

# Individual Gemini API Keys for Automatic Rotation
# Add as many keys as you need: GEMINI_API_1, GEMINI_API_2, GEMINI_API_3, ...
GEMINI_API_1=your_first_gemini_api_key_here
GEMINI_API_2=your_second_gemini_api_key_here
GEMINI_API_3=your_third_gemini_api_key_here
GEMINI_API_4=your_fourth_gemini_api_key_here

# Model to use (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Target website to scrape for knowledge context
TARGET_SITE=https://www.preciousedu.in/

# Cache duration in seconds (21600 seconds = 6 hours)
CACHE_TTL_SECONDS=21600

# Allowed CORS origins (use '*' to allow any domain, or comma-separated URLs)
ALLOWED_ORIGINS=*
